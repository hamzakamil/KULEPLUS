# Kök ortam değişkenleri — README §12.3
# Uygulama tarafı doğrulama: env.ts (Zod) — eksik/boşsa uygulama başlamaz (Faz 1).

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
SITE_URL=http://localhost:4321
API_URL=http://localhost:3000

DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/erp_db
DATABASE_MIGRATOR_URL=postgresql://app_migrator:CHANGE_ME@localhost:5432/erp_db
DATABASE_PLATFORM_URL=postgresql://app_platform:CHANGE_ME@localhost:5432/erp_db
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=               # 32 byte base64

# Docker host portu — yerel makinede 5432 doluysa değiştirin (örn. 5433)
POSTGRES_PORT=5432

SMTP_URL=smtp://localhost:1025
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=erp-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

EINVOICE_PROVIDER=mock
PAYMENT_PROVIDER=mock         # mock | iyzico | manual
SMS_PROVIDER=mock
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

PLATFORM_BOOTSTRAP_EMAIL=

# Public site (apps/site)
PUBLIC_API_URL=http://localhost:3000
PUBLIC_PLAUSIBLE_DOMAIN=

# Not: Boş ve örnek değerlerle üretim başlatılamaz.
# Parolalar, tokenlar ve anahtarlar kaynak koduna eklenmez.
