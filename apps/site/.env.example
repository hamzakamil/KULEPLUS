# apps/site — public değişkenler (README §12.3)

# Uygulama paneli (apps/web) — CTA linkleri ve UTM yönlendirmesi için
PUBLIC_APP_URL=http://localhost:5173
# Kayıt (signup) URL'si — apps/web kayıt rotası netleşince güncellenmeli
PUBLIC_SIGNUP_URL=http://localhost:5173/kayit

# İletişim formu uç noktası (ROADMAP Faz 2: POST /api/v1/public/contact)
PUBLIC_API_URL=http://localhost:3000

# Plausible (KVKK dostu analitik) — boş bırakılırsa script enjekte edilmez
PUBLIC_PLAUSIBLE_DOMAIN=

