<!--
  Hero görsel rotasyonu — ürün ekranları sırayla değişir.
  · İmleç kartın üzerindeyken veya klavye kartın içine girdiğinde durur
  · Sekme arka plandayken çalışmaz; prefers-reduced-motion açıksa döngü hiç kurulmaz
  · JS kapalıysa ilk ekran görünür kalır (istismara açık animasyon yok)
-->
<script>
  (function () {
    var card = document.querySelector('[data-shot-card]');
    var figure = document.querySelector('[data-shot]');
    var slides = Array.prototype.slice.call(document.querySelectorAll('.dash-shot-slide'));
    if (!card || !figure || slides.length < 2) return;

    var dots = Array.prototype.slice.call(document.querySelectorAll('[data-shot-index]'));
    var title = document.querySelector('[data-shot-title]');
    var note = document.querySelector('[data-shot-note]');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var current = 0;
    var timer = null;
    var paused = false;

    function show(index) {
      current = (index + slides.length) % slides.length;
      slides.forEach(function (slide, i) {
        var active = i === current;
        slide.classList.toggle('is-active', active);
        // aktif olmayan ekran klavye ve ekran okuyucu dışında kalır
        slide.inert = !active;
        if (active) slide.removeAttribute('aria-hidden');
        else slide.setAttribute('aria-hidden', 'true');
      });
      dots.forEach(function (dot, i) {
        if (i === current) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      if (title) title.textContent = slides[current].getAttribute('data-title') || '';
      if (note) note.textContent = slides[current].getAttribute('data-note') || '';
    }

    function stop() {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
    }

    function start() {
      stop();
      if (paused || reduce.matches) return;
      timer = window.setInterval(function () {
        show(current + 1);
      }, 6000);
    }

    // Kullanici kartla etkileşirken döngü durur (imleç/maruziyet karta girdiğinde)
    function pause() {
      paused = true;
      stop();
    }

    function resume() {
      paused = false;
      start();
    }

    // LCP için: yalnızca ilk ekran yüklenir, diğerleri sayfa açıldıktan sonra alınır
    function loadRest() {
      slides.forEach(function (slide, i) {
        if (i === 0) return;
        var img = slide.querySelector('img[data-src]');
        if (img) img.src = img.getAttribute('data-src') || '';
      });
    }

    window.addEventListener('load', function () {
      if ('requestIdleCallback' in window) window.requestIdleCallback(loadRest, { timeout: 4000 });
      else loadRest();
    });

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        show(parseInt(dot.getAttribute('data-shot-index') || '0', 10));
        start();
      });
    });

    ['mouseenter', 'focusin'].forEach(function (event) {
      card.addEventListener(event, pause);
    });
    card.addEventListener('focusout', function (event) {
      if (!card.contains(event.relatedTarget)) resume();
    });
    card.addEventListener('mouseleave', resume);
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) stop();
      else start();
    });

    show(0);
    start();
  })();
</script>
