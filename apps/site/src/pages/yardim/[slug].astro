---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('yardim');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

// Plausible: help_article_view (docs/product/seo-analytics.md)
---

<BaseLayout title={article.data.title} description={article.data.description}>
  <article class="section">
    <div class="container" style="max-width: 46rem;">
      <p>
        <a href="/yardim">← Yardım Merkezi</a>
      </p>
      <h1>{article.data.title}</h1>
      {article.data.phase > 2 && (
        <p>
          <span class="badge">Faz {article.data.phase}’te geliyor</span>
        </p>
      )}
      <div class="help-content">
        <Content />
      </div>
    </div>
  </article>

  <script is:inline>
    window.plausible &&
      window.plausible('help_article_view', { props: { article: location.pathname } });
  </script>
</BaseLayout>

<style>
  .help-content :global(h2) {
    margin-top: 2rem;
  }

  .help-content :global(ol),
  .help-content :global(ul) {
    padding-left: 1.25rem;
  }

  .help-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .help-content :global(code) {
    background: var(--color-surface);
    padding: 0.1em 0.35em;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }
</style>
