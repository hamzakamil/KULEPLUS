---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../i18n';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<BaseLayout
  title="Blog"
  description="Kuleplus blogu: ön muhasebe, e-dönüşüm ve KOBİ’ler için bulut ERP yazıları."
>
  <section class="section">
    <div class="container">
      <h1>Blog</h1>
      <p class="lead">Ön muhasebe, e-dönüşüm ve KOBİ dijitalleşmesi üzerine yazılar.</p>

      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <article class="card">
              <p class="muted post-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
                · {post.data.author}
              </p>
              <h2 class="post-title">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h2>
              <p class="muted">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <p>
                  {post.data.tags.map((tag) => (
                    <span class="badge" style="margin-right: 0.375rem;">
                      {tag}
                    </span>
                  ))}
                </p>
              )}
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 1.5rem;
  }

  .post-meta {
    font-size: 0.875rem;
    margin-bottom: 0.375rem;
  }

  .post-title {
    font-size: 1.375rem;
    margin-bottom: 0.375rem;
  }

  .post-title a {
    text-decoration: none;
    color: var(--color-text);
  }

  .post-title a:hover {
    color: var(--color-primary);
  }
</style>
