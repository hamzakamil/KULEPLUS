---
import { SITE, type NavLink } from '../config/site';
import { t } from '../i18n';

interface Props {
  nav: NavLink[];
}

const { nav } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${SITE.name} — ${t('site.nav.home')}`}>
      <span class="brand-mark" aria-hidden="true">
        ▲
      </span>
      <span class="brand-name">{SITE.name}</span>
    </a>

    <nav aria-label={t('site.a11y.mainNav')} class="main-nav">
      <ul>
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={currentPath === item.href.replace(/\/$/, '') ? 'page' : undefined}
            >
              {t(item.labelKey)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href={SITE.appUrl} class="header-login">
        Giriş
      </a>
      <!-- UTM koruması: Plausible UTM kuralı — tıklama anında URL'e eklenir (seo-analytics.md) -->
      <a
        href={SITE.signupUrl}
        class="btn btn-primary plausible-event-name=cta_click_signup"
        data-utm-link
      >
        {t('site.cta.signup')}
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4rem;
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-text);
    font-weight: 800;
    font-size: 1.125rem;
  }

  .brand-mark {
    color: var(--color-primary);
  }

  .main-nav {
    margin-inline: auto;
  }

  .main-nav ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .main-nav a {
    text-decoration: none;
    color: var(--color-muted);
    font-weight: 500;
    font-size: 0.9375rem;
    padding: 0.25rem 0;
  }

  .main-nav a:hover,
  .main-nav a[aria-current='page'] {
    color: var(--color-primary);
  }

  .main-nav a[aria-current='page'] {
    box-shadow: inset 0 -2px 0 var(--color-primary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header-login {
    color: var(--color-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .header-login:hover {
    color: var(--color-primary);
  }

  @media (max-width: 60rem) {
    .main-nav {
      order: 3;
      width: 100%;
      margin-inline: 0;
      border-top: 1px solid var(--color-border);
      padding-top: 0.5rem;
    }

    .main-nav ul {
      gap: 0.75rem 1rem;
    }

    .header-actions {
      margin-left: auto;
    }
  }
</style>
