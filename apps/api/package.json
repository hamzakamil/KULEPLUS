{
  "name": "@kuleplus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express API — modüler monolit (SPEC §1.2: src/modules/<modül>/…)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "vercel-build": "node ../../scripts/build-vercel-workspaces.mjs --vercel",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@kuleplus/db": "*",
    "@kuleplus/shared": "*",
    "@node-rs/argon2": "^2.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "express": "^4.21.0",
    "fflate": "0.8.2",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.0",
    "nodemailer": "^10.0.15",
    "otplib": "^12.0.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "saxon-js": "2.7.0",
    "tsx": "^4.19.0",
    "xmllint-wasm": "5.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.21.5",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.9.0",
    "vitest": "^2.0.0"
  }
