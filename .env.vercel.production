# KULEPLUS — Vercel Production ortam değişkenleri (import dosyası)
# Kullanım: Vercel Dashboard → Project → Settings → Environment Variables
# → "..." menüsü → "Import .env" → bu dosyayı seç → Production (+Preview) işaretle → Redeploy
# Notlar:
# - PUT_YOUR_... yazan her değeri gerçek değeriyle değiştirmeden import ETME.
# - Dosyadaki hiçbir gerçek sır yok; şifre/token üretildikçe bu dosyaya değil,
#   doğrudan Vercel paneline işlenir. Bu dosya repoda durabilir (sır içermez),
#   ancak .gitignore yine de *.production.env kalıbını dışlamaz — commitlenebilir.
# - API başlatma kapısı: apps/api/src/config/env.ts (DATABASE_URL, REDIS_URL,
#   JWT_ACCESS_SECRET, JWT_REFRESH_SECRET zorunlu; eksikse process exit).

NODE_ENV=production
PORT=3000

# --- Uygulama URL'leri (canlı domain'lerinle değiştir) ---
APP_URL=PUT_YOUR_WEB_URL
API_URL=PUT_YOUR_API_URL
SITE_URL=PUT_YOUR_SITE_URL

# --- Supabase PostgreSQL (roller: docker/postgres/init/01-roles.sql) ---
# app/platform: pooler (6543 + pgbouncer) — Vercel serverless bağlantı patlamasını önler.
# migrator: direkt (5432) — migration/SET komutları pooler'da çalışmaz.
DATABASE_URL=postgresql://app_user:PUT_YOUR_APP_USER_PASSWORD@db.lszcvzstgwlmqqomyizn.supabase.co:6543/postgres?pgbouncer=true
DATABASE_MIGRATOR_URL=postgresql://app_migrator:PUT_YOUR_MIGRATOR_PASSWORD@db.lszcvzstgwlmqqomyizn.supabase.co:5432/postgres
DATABASE_PLATFORM_URL=postgresql://app_platform:PUT_YOUR_PLATFORM_PASSWORD@db.lszcvzstgwlmqqomyizn.supabase.co:6543/postgres?pgbouncer=true

# --- Redis (Upstash önerilir; zorunlu) ---
REDIS_URL=PUT_YOUR_REDIS_URL

# --- JWT (en az 32 karakter, iki ayrı rastgele string; zorunlu) ---
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=PUT_YOUR_64CHAR_ACCESS_SECRET
JWT_REFRESH_SECRET=PUT_YOUR_64CHAR_REFRESH_SECRET

# --- E-posta (Gmail OAuth2; boşsa e-posta kuyruğu iskelette kalır) ---
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_ACCESS_TOKEN=
SMTP_ACCESS_TOKEN_EXPIRY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Ödeme (mock varsayılan; iyzico seçilirse anahtarlar zorunlu, fail-fast) ---
PAYMENT_PROVIDER=mock
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com
IYZICO_PRICING_PLAN_REF=
IYZICO_MERCHANT_ID=

# --- e-Fatura / SMS (şu an mock; gerçek entegratör gelince dolar) ---
EINVOICE_PROVIDER=mock
SMS_PROVIDER=mock

# --- Google ile giriş (ADR-0023; boşsa sosyal giriş kapalı, uygulamayı kırmaz) ---
GOOGLE_CLIENT_ID=

# --- Web Push PWA (boşsa worker log mock'u kullanır) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destek@kuleplus.local

# --- Platform bootstrap ---
PLATFORM_BOOTSTRAP_EMAIL=

# --- Web (Vite build-time; apps/web) ---
VITE_API_URL=PUT_YOUR_API_URL
VITE_APP_URL=PUT_YOUR_WEB_URL
VITE_SITE_URL=PUT_YOUR_SITE_URL

# --- Site (Astro; apps/site) ---
PUBLIC_API_URL=PUT_YOUR_API_URL
PUBLIC_APP_URL=PUT_YOUR_WEB_URL
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_SIGNUP_URL=PUT_YOUR_WEB_URL
