{
  "name": "kuleplus",
  "private": true,
  "version": "4.3.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"npm run dev --workspace apps/api\" \"npm run dev --workspace apps/worker\" \"npm run dev --workspace apps/web -- --host 127.0.0.1\"",
    "dev:site": "npm run dev --workspace apps/site",
    "build:site": "npm run build --workspace apps/site",
    "preview:site": "npm run preview --workspace apps/site",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prod:build": "docker compose --env-file .env.production -f docker-compose.prod.yml build",
    "prod:up": "docker compose --env-file .env.production -f docker-compose.prod.yml up -d",
    "prod:down": "docker compose --env-file .env.production -f docker-compose.prod.yml down",
    "prod:logs": "docker compose --env-file .env.production -f docker-compose.prod.yml logs -f api worker",
    "prod:migrate": "docker compose --env-file .env.production -f docker-compose.prod.yml run --rm migrate",
    "prod:status": "docker compose --env-file .env.production -f docker-compose.prod.yml ps",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "governance:check": "node scripts/governance-check.mjs",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "test:a11y": "node scripts/a11y-check.mjs --strict",
    "docs:fix-encoding": "node scripts/fix-docs-encoding.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axe-core": "^4.10.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "puppeteer-core": "^24.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=22"
  }
}
