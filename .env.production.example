# KULEPLUS — ÜRETİM ortam değişkenleri (docker-compose.prod.yml ile kullanılır)
#
# Kurulum:
#   cp .env.production.example .env.production
#   # aşağıdaki PUT_YOUR_* ve CHANGE_ME değerlerini GERÇEKLERİYLE değiştirin
#   docker compose -f docker-compose.prod.yml up -d
#
# .env.production commit'lenMEZ (.gitignore `.env*` kalıbı dışlıyor mu kontrol edin;
# compose `env_file` ile okur, imaja asla girmez — bkz. .dockerignore).
#
# Zorunlu alanların asıl kaynağı: apps/api/src/config/env.ts (Zod).
# Eksik/boşsa API BAŞLAMAZ (fail-fast) — sessiz varsayılana düşmez.

NODE_ENV=production
PORT=3000

# --- Dışa dönük URL'ler (CORS + e-posta iç linkleri) ---
APP_URL=https://PUT_YOUR_WEB_DOMAIN
API_URL=https://PUT_YOUR_API_DOMAIN
SITE_URL=https://PUT_YOUR_SITE_DOMAIN

# --- PostgreSQL ---
# Host adı `postgres` = compose servis adı (container ağı). localhost DEĞİL.
# Üç rol ayrıdır (SPEC §7.1); parolaları docker/postgres/init/01-roles.sql içindeki
# CHANGE_ME ile AYNI olmalı — production'da o dosyadaki CHANGE_ME'yi de değiştirin
# ya da container ilk kurulduktan sonra ALTER ROLE ile güncelleyin.
DATABASE_URL=postgresql://app_user:PUT_YOUR_APP_USER_PASSWORD@postgres:5432/erp_db
DATABASE_MIGRATOR_URL=postgresql://app_migrator:PUT_YOUR_MIGRATOR_PASSWORD@postgres:5432/erp_db
DATABASE_PLATFORM_URL=postgresql://app_platform:PUT_YOUR_PLATFORM_PASSWORD@postgres:5432/erp_db

# --- compose'un kendisi için (container içi env değil, interpolation) ---
POSTGRES_SUPER_PASSWORD=PUT_YOUR_SUPERUSER_PASSWORD
POSTGRES_PORT=5432
REDIS_PORT=6379
API_BIND=127.0.0.1
API_PORT=3000

# --- Web (Vue SPA) + TLS ucu ---
# SPA, API'yi aynı origin üzerinden `/api` altında çağırır (nginx proxy'si).
# Farklı bir API alan adı kullanacaksanız hem burayı hem APP_URL/API_URL'ı ve
# docker/web/nginx.conf içindeki proxy hedefini güncellemeniz gerekir.
VITE_API_URL=/api
WEB_BIND=127.0.0.1
WEB_PORT=8081

# Caddy'nin sertifika alacağı alan adı. Gerçek alan adı -> Let's Encrypt
# (80. port dışa açık olmalı). Test için `localhost` -> Caddy iç CA kullanır.
WEB_DOMAIN=localhost
# Let's Encrypt kayıt e-postası (sertifika süresi doluyor uyarıları buraya gelir).
CADDY_EMAIL=ops@PUT_YOUR_DOMAIN
# Üretimde 80/443 boş bırakın; yerel testte çakışma varsa değiştirin.
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# --- Redis (BullMQ) ---
REDIS_URL=redis://redis:6379

# --- JWT — env.ts min. 32 karakter doğrular, eksikse süreç çıkmaz ---
# Üret: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=PUT_YOUR_AT_LEAST_32_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=PUT_YOUR_OTHER_AT_LEAST_32_CHAR_RANDOM_STRING
ENCRYPTION_KEY=

# --- E-posta (üretimde Mailpit KULLANILMAZ) ---
SMTP_URL=smtps://PUT_YOUR_SMTP_HOST:465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Dosya depolama (üretimde MinIO yerine S3 uyumlu gerçek bucket önerilir) ---
S3_ENDPOINT=https://PUT_YOUR_S3_ENDPOINT
S3_BUCKET=kuleplus-files
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Sağlayıcılar ---
# Üretimde mock BIRAKMAYIN: ödeme/efatura sahte sonuç üretir.
PAYMENT_PROVIDER=manual
EINVOICE_PROVIDER=mock
SMS_PROVIDER=mock
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com
IYZICO_PRICING_PLAN_REF=
IYZICO_MERCHANT_ID=

# --- Google ile giriş (ADR-0023) — boşsa sosyal giriş kapalı kalır (bozar değil) ---
GOOGLE_CLIENT_ID=

# --- Web Push (PWA) — boşsa worker log mock'una düşer ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destek@PUT_YOUR_DOMAIN

# --- Platform ilk yöneticisi (bootstrap:admin) ---
PLATFORM_BOOTSTRAP_EMAIL=

# Yorum: bu dosyada sır TUTMAYIN; gerçek değerler sunucuda, dosya izinleri 600 ile.
