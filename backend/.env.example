# Sunucu
PORT=3000
NODE_ENV=development

# Veritabanı Tipi: mongodb veya postgresql
DB_TYPE=mongodb

# MongoDB
MONGODB_URI=mongodb://localhost:27017/muhasebe

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=muhasebe
PG_USERNAME=postgres
PG_PASSWORD=postgres

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Varsayılan Para Birimi
DEFAULT_CURRENCY=TRY

# Log Seviyesi: error, warn, info, debug
LOG_LEVEL=info
